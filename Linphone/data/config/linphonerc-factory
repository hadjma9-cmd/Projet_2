[account_creator]
backend=1
# 1 means FlexiAPI, 0 is XMLRPC
url=https://subscribe.linphone.org/api/
# replace above URL by https://staging-subscribe.linphone.org/api/ for testing
# url=https://flexisip-staging-master.linphone.org/api/

[alerts]
alerts_enabled=1

[app]
activation_code_length=4
prefer_basic_chat_room=1
record_aware=1

[assistant]
algorithm=SHA-256
password_min_length=6
username_regex=^[a-z0-9+_.\-]*$

[lime]
lime_update_threshold=86400

[misc]
aggregate_imdn=1
enable_basic_to_client_group_chat_room_migration=0
enable_simple_group_chat_message_state=0
notify_each_friend_individually_when_presence_received=0
hide_empty_chat_rooms=1
file_transfer_server_url=https://subscribe.linphone.org:4444/upload

[net]
force_ice_disablement=0
mtu=1300

[rtp]
accept_any_encryption=1

[sip]
publish_default_value=1
auto_answer_replacing_calls=1
auto_net_state_mon=1
chat_messages_aggregation=1
chat_messages_aggregation_delay=1000
guess_hostname=1
ping_with_options=0
register_only_when_network_is_up=1
rls_uri=sips:rls@sip.linphone.org
update_presence_model_timestamp_before_publish_expires_refresh=1
use_cpim=1
zrtp_key_agreements_suites=MS_ZRTP_KEY_AGREEMENT_K255_MLK512,MS_ZRTP_KEY_AGREEMENT_K255_KYB512

[sound]
#remove this property for any application that is not Linphone public version itself
ec_calibrator_cool_tones=1
ec_filter=MSWebRTCAEC

[ui]
assistant_supports_phone_numbers/readonly=0
use_qrcode=0

[video]
# Capacite video du Core : sans ces deux cles, core->videoEnabled() est faux
# et CallModel::activateLocalVideo() envoie le re-INVITE sans video.
# N'active PAS la video sur les appels : c'est automatically_initiate qui decide.
capture=1
display=1
auto_resize_preview_to_keep_ratio=1
max_conference_size=vga
other_display_mode=Hybrid

[remote_contact_directory_0]
enabled=1
type=ldap
uri=ldap://154.41.128.150:10389
timeout=5
min_characters=0
results_limit=50
delay=2000
ldap_auth_method=1

# 1. Base globale pour couvrir TOUS les domaines de l'annuaire

ldap_filter=(|(cn=*%s*)(displayName=*%s*)(telephoneNumber=*%s*))
ldap_name_attribute=displayName,cn,sn
ldap_sip_attribute=telephoneNumber

# 2. Template dynamique par utilisateur et domaine
ldap_photo_url_template=https://testdomaine.gama-it.fr/avatars/avatar.php?user={sip_username}&domain={sip_domain}
ldap_timeout_tls_ms=1000
ldap_use_sal=1
ldap_use_tls=0
ldap_verify_server_certificates=-1
